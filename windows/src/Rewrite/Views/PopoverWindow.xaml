<Window x:Class="Rewrite.Views.PopoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rewrite"
        Width="380" Height="620"
        WindowStyle="None" AllowsTransparency="False" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" Background="Transparent"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI" UseLayoutRounding="True">

    <Window.Resources>
        <!-- Round glass icon button -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="17" Background="{StaticResource GlassFill}"
                                BorderBrush="{StaticResource GlassStroke}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent round button (send) -->
        <Style x:Key="AccentBtn" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Foreground" Value="{StaticResource AccentInk}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="14" Background="{StaticResource Accent}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small text button (Copy / Retry) -->
        <Style x:Key="MiniBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="10" Background="{StaticResource GlassFill}" Padding="10,5">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segment button (Writing / Prompt) -->
        <Style x:Key="SegBtn" TargetType="Button">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="13" Background="{TemplateBinding Background}" Padding="18,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action chip template (PresetAction) -->
        <DataTemplate x:Key="ChipTemplate">
            <Button Command="{Binding DataContext.SelectActionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding Id}" Cursor="Hand" Margin="0,0,7,0">
                <Button.Background>
                    <MultiBinding Converter="{StaticResource SelBrush}">
                        <Binding Path="DataContext.SelectedActionId" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                        <Binding Path="Id" />
                    </MultiBinding>
                </Button.Background>
                <Button.Foreground>
                    <MultiBinding Converter="{StaticResource SelBrush}" ConverterParameter="ink">
                        <Binding Path="DataContext.SelectedActionId" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                        <Binding Path="Id" />
                    </MultiBinding>
                </Button.Foreground>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="14" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource GlassStroke}" BorderThickness="1" Padding="13,7">
                            <TextBlock Text="{Binding Label}" FontSize="12.5" Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!-- Chat turn template -->
        <DataTemplate x:Key="TurnTemplate">
            <StackPanel Margin="0,7" MaxWidth="320"
                        HorizontalAlignment="{Binding IsUser, Converter={StaticResource UserAlign}}">
                <StackPanel Orientation="Horizontal" Margin="2,0,0,4"
                            Visibility="{Binding IsAssistant, Converter={StaticResource BoolVis}}">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold" />
                </StackPanel>
                <Border CornerRadius="14" Padding="13,10" Background="{Binding IsUser, Converter={StaticResource BubbleBrush}}">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13.5"
                               Foreground="{Binding IsError, Converter={StaticResource ErrBrush}}" />
                </Border>
                <StackPanel Orientation="Horizontal" Margin="2,5,0,0">
                    <StackPanel.Visibility>
                        <MultiBinding Converter="{StaticResource AndVis}">
                            <Binding Path="IsAssistant" />
                            <Binding Path="IsStreaming" Converter="{StaticResource InvBool}" />
                        </MultiBinding>
                    </StackPanel.Visibility>
                    <Button Content="Copy" Style="{StaticResource MiniBtn}"
                            Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />
                    <Button Content="Retry" Style="{StaticResource MiniBtn}"
                            Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <!-- Subtle dark overlay deepens the acrylic glass -->
    <Grid Background="#220B0B0F">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="14,11">
            <Button Style="{StaticResource IconBtn}" Content="&#xE81C;" HorizontalAlignment="Left"
                    IsEnabled="False" ToolTip="History (coming soon)" />
            <Border HorizontalAlignment="Center" CornerRadius="16" Padding="3"
                    Background="{StaticResource GlassFill}" BorderBrush="{StaticResource GlassStroke}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource SegBtn}" Content="Writing"
                            Command="{Binding SetModeCommand}" CommandParameter="Writing"
                            Background="{Binding Mode, Converter={StaticResource ModeBrush}, ConverterParameter=Writing}"
                            Foreground="{Binding Mode, Converter={StaticResource ModeBrush}, ConverterParameter=Writing.ink}" />
                    <Button Style="{StaticResource SegBtn}" Content="Prompt"
                            Command="{Binding SetModeCommand}" CommandParameter="Prompt"
                            Background="{Binding Mode, Converter={StaticResource ModeBrush}, ConverterParameter=Prompt}"
                            Foreground="{Binding Mode, Converter={StaticResource ModeBrush}, ConverterParameter=Prompt.ink}" />
                </StackPanel>
            </Border>
            <Button x:Name="CloseBtn" Style="{StaticResource IconBtn}" Content="&#xE711;" HorizontalAlignment="Right"
                    Click="Close_Click" ToolTip="Close" />
        </Grid>

        <!-- Chat -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,0">
            <ItemsControl ItemsSource="{Binding Thread}" ItemTemplate="{StaticResource TurnTemplate}" Margin="0,4,0,12" />
        </ScrollViewer>

        <!-- Composer -->
        <StackPanel Grid.Row="2" Margin="12,8,12,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource IconBtn}" Content="&#xE710;"
                        Command="{Binding NewChatCommand}" Margin="0,0,8,0" ToolTip="New chat" />
                <Border Grid.Column="1" CornerRadius="21" Padding="5"
                        Background="{StaticResource GlassFill}" BorderBrush="{StaticResource GlassStroke}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="Composer" Grid.Column="0" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextPrimary}" CaretBrush="{StaticResource Accent}"
                                 FontSize="13.5" VerticalAlignment="Center" Padding="8,4"
                                 AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="92"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="Composer_PreviewKeyDown" />
                        <Button Grid.Column="1" Style="{StaticResource AccentBtn}" Content="&#xE724;"
                                Command="{Binding SendCommand}"
                                Visibility="{Binding IsLoading, Converter={StaticResource InvBoolVis}}" />
                        <Button Grid.Column="1" Style="{StaticResource AccentBtn}" Content="&#xE71A;"
                                Command="{Binding StopCommand}"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}" />
                    </Grid>
                </Border>
                <Button Grid.Column="2" Style="{StaticResource IconBtn}" Content="&#xE720;" Margin="8,0,0,0"
                        IsEnabled="False" ToolTip="Dictation (coming soon)" />
            </Grid>

            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding ToggleSmartCommand}" Cursor="Hand" Margin="0,0,7,0"
                            Visibility="{Binding IsWriting, Converter={StaticResource BoolVis}}"
                            Background="{Binding SmartActive, Converter={StaticResource BoolBrush}}"
                            Foreground="{Binding SmartActive, Converter={StaticResource BoolBrush}, ConverterParameter=ink}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="14" Background="{TemplateBinding Background}"
                                        BorderBrush="{StaticResource GlassStroke}" BorderThickness="1" Padding="13,7">
                                    <TextBlock Text="✦ Smart" FontSize="12.5" Foreground="{TemplateBinding Foreground}" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <ItemsControl ItemsSource="{Binding Actions}" ItemTemplate="{StaticResource ChipTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</Window>
