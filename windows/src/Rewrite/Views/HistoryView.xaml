<UserControl x:Class="Rewrite.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <!-- Glass segment button (Writing / Prompt filter) -->
        <Style x:Key="Seg" TargetType="Button">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="13" Background="{TemplateBinding Background}" Padding="16,6">
                            <ContentPresenter HorizontalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- History card -->
        <DataTemplate x:Key="Card">
            <Button Command="{Binding DataContext.OpenHistoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}" Cursor="Hand" Margin="0,0,0,10" HorizontalContentAlignment="Stretch">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="14" Background="{StaticResource GlassFill}"
                                BorderBrush="{StaticResource GlassStroke}" BorderThickness="1" Padding="12">
                            <StackPanel>
                                <TextBlock Text="{Binding ActionLabel}" Foreground="{StaticResource Accent}"
                                           FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Output}" Foreground="{StaticResource TextPrimary}"
                                           FontSize="12" TextTrimming="CharacterEllipsis" MaxHeight="36"
                                           TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16,0,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Filter row -->
        <Grid Grid.Row="0" Margin="0,8,0,8">
            <Border HorizontalAlignment="Left" CornerRadius="16" Padding="3"
                    Background="{StaticResource GlassFill}" BorderBrush="{StaticResource GlassStroke}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Seg}" Content="Writing"
                            Command="{Binding SetHistoryModeCommand}" CommandParameter="Writing"
                            Background="{Binding HistoryMode, Converter={StaticResource ModeBrush}, ConverterParameter=Writing}"
                            Foreground="{Binding HistoryMode, Converter={StaticResource ModeBrush}, ConverterParameter=Writing.ink}" />
                    <Button Style="{StaticResource Seg}" Content="Prompt"
                            Command="{Binding SetHistoryModeCommand}" CommandParameter="Prompt"
                            Background="{Binding HistoryMode, Converter={StaticResource ModeBrush}, ConverterParameter=Prompt}"
                            Foreground="{Binding HistoryMode, Converter={StaticResource ModeBrush}, ConverterParameter=Prompt.ink}" />
                </StackPanel>
            </Border>
            <Button Content="Clear" Command="{Binding ClearHistoryCommand}" Cursor="Hand"
                    HorizontalAlignment="Right" Foreground="{StaticResource TextPrimary}" FontSize="12.5">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="14" Background="{StaticResource GlassFill}"
                                BorderBrush="{StaticResource GlassStroke}" BorderThickness="1" Padding="14,8">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding HistoryItems}" ItemTemplate="{StaticResource Card}" Margin="0,0,0,16" />
        </ScrollViewer>
    </Grid>
</UserControl>
