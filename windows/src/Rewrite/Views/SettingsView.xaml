<UserControl x:Class="Rewrite.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style x:Key="GlassInput" TargetType="Control">
            <Setter Property="Background" Value="{StaticResource GlassFill}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,4,18,18">
        <StackPanel>
            <TextBlock Text="PROVIDER" Style="{StaticResource FieldLabel}" Margin="0,4,0,4" />
            <RadioButton Content="Claude (Anthropic API)" GroupName="prov" IsChecked="{Binding ProviderIsAnthropic}" />
            <RadioButton Content="Open-source local (Ollama)" GroupName="prov" IsChecked="{Binding ProviderIsOllama}" />

            <!-- Anthropic -->
            <StackPanel Visibility="{Binding ProviderIsAnthropic, Converter={StaticResource BoolVis}}">
                <TextBlock Text="API KEY" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="KeyBox" Style="{StaticResource GlassInput}" PasswordChanged="KeyBox_Changed" />
                <TextBlock Text="MODEL" Style="{StaticResource FieldLabel}" />
                <ComboBox Style="{StaticResource GlassInput}" ItemsSource="{Binding AnthropicModels}"
                          SelectedItem="{Binding AnthropicModel}" />
            </StackPanel>

            <!-- Ollama -->
            <StackPanel Visibility="{Binding ProviderIsOllama, Converter={StaticResource BoolVis}}">
                <TextBlock Text="HOST" Style="{StaticResource FieldLabel}" />
                <TextBox Style="{StaticResource GlassInput}" Text="{Binding OllamaHost, UpdateSourceTrigger=LostFocus}" />
                <TextBlock Text="MODEL" Style="{StaticResource FieldLabel}" />
                <TextBox Style="{StaticResource GlassInput}" Text="{Binding OllamaModel, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>

            <Button Content="Verify connection" Command="{Binding VerifyCommand}" Cursor="Hand"
                    HorizontalAlignment="Left" Margin="0,14,0,0" Foreground="{StaticResource AccentInk}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="13" Background="{StaticResource Accent}" Padding="16,8">
                            <ContentPresenter TextElement.Foreground="{StaticResource AccentInk}" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <TextBlock Text="{Binding VerifyStatus}" Foreground="{StaticResource TextSecondary}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,8,0,0" />

            <TextBlock Text="GENERAL" Style="{StaticResource FieldLabel}" Margin="0,18,0,4" />
            <CheckBox Content="Smart send (rewrite vs. fulfill a request)" IsChecked="{Binding SmartIntent}" />
            <CheckBox Content="Copy result automatically" IsChecked="{Binding AutoCopyResult}" />

            <TextBlock Text="{Binding AppVersion, StringFormat='Version {0}'}"
                       Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,20,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
