<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Microphone for dictation. App is intentionally NOT sandboxed (direct
         distribution) so it can use Accessibility, global hotkeys, and the
         optional Claude CLI subprocess. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
